<?xml version="1.0" encoding="utf-8"?>
<!--
  Calm: a calm, minimal map style for OsmAnd, with a light (day) and a dark (night) look.
  Colors start from the Protomaps "light" and "dark" basemaps (https://github.com/protomaps/basemaps, visual design
  CC0), adjusted for readability: labels and night roads are stronger, and road edges are visible by day.
  Builds on OsmAnd's default style and only replaces colors. OsmAnd's map mode picks day or night.
  Install: OsmAnd > Menu > Maps & Resources > Local > Rendering styles > Import, then Configure map > Map style.

  How each color works: OsmAnd uses the first <case> that matches. Every attribute ends with a day
  (nightMode="false") and a night (nightMode="true") case, so the default style's own colors never leak through.
  Special cases above them (cycle streets, access restrictions, street lighting, ...) keep OsmAnd's map options working.
  Only use literal colors (#RRGGBB or #AARRGGBB): names like $null from the default style are not available here.
-->
<renderingStyle name="Calm" depends="default" defaultColor="#e2dfda" version="1">

	<!-- Night colors the default style uses for shaded areas (cemeteries, scrub, orchards, golf) and wetlands -->
	<renderingConstant name="shaderColorNight" value="#192a24"/>
	<renderingConstant name="wetlandColorNight" value="#1d2626"/>

	<!-- Land background. With 'Hide polygons' it stays transparent so satellite underlays show through. -->
	<renderingAttribute name="defaultColor">
		<case noPolygons="true" attrColorValue="#00e2dfda"/>
		<case nightMode="false" attrColorValue="#e2dfda"/>
		<case nightMode="true" attrColorValue="#1f1f1f"/>
	</renderingAttribute>

